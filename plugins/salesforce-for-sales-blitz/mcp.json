{
  "mcpServers": {
    "salesforce-h360": {
      "type": "http",
      "url": "${SALESFORCE_MCP_URL}",
      "auth": {
        "CLIENT_ID": "${CLIENT_ID}",
        "CLIENT_SECRET": "${CLIENT_SECRET}",
        "scopes": ["mcp_api", "refresh_token"]
      }
    },
    "workspace": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CURSOR_PLUGIN_ROOT}/mocks/workspace_server.py"]
    }
  }
}
